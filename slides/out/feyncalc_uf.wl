WriteString[out, "double box|" <> ToString[InputForm[Expand[r[[1]]]]] <> "|" <> ToString[InputForm[Expand[r[[2]]]]] <> "\n"];
ClearScalarProducts[]; SPD[p, p] = s;
r = FCFeynmanPrepare[{FAD[{(1)*l1, Sqrt[m^2]}], FAD[{(1)*l2, Sqrt[m^2]}], FAD[{(1)*l3, Sqrt[m^2]}], FAD[{(-1)*l1 + (-1)*l2 + (-1)*l3 + (1)*p, Sqrt[m^2]}]}, {l1, l2, l3}, Names -> x, Indexed -> False];
