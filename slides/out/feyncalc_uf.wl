ClearScalarProducts[]; SPD[p1, p1] = 0; SPD[p2, p2] = 0; SPD[p3, p3] = 0; SPD[p1, p2] = s/2; SPD[p2, p3] = t/2; SPD[p1, p3] = -(s+t)/2;
r = FCFeynmanPrepare[{FAD[{(1)*l1, 0}], FAD[{(1)*l2, 0}], FAD[{(1)*l3, 0}], FAD[{(-1)*l1 + (1)*p1 + (1)*p2, 0}], FAD[{(-1)*l2 + (1)*p1 + (1)*p2, 0}], FAD[{(-1)*l3 + (1)*p1 + (1)*p2, 0}], FAD[{(-1)*l1 + (1)*p2, 0}], FAD[{(1)*l1 + (-1)*l2, 0}], FAD[{(1)*l2 + (-1)*l3, 0}], FAD[{(1)*l3 + (1)*p3, 0}]}, {l1, l2, l3}, Names -> x, Indexed -> False];
